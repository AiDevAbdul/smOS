{
  "name": "smos",
  "version": "1.1.1",
  "description": "Autonomous Social Media Operating System — Meta ads management, organic social, reporting, and daily optimization via Claude Code",
  "author": {
    "name": "Abdul",
    "email": "abdul@duckercreative.com"
  },
  "homepage": "https://github.com/duckercreative/smOS",
  "repository": "https://github.com/duckercreative/smOS",
  "license": "UNLICENSED",
  "keywords": ["meta-ads", "facebook-ads", "instagram-ads", "social-media", "marketing", "agency", "automation"],

  "hooks": "./hooks/hooks.json",

  "mcpServers": {
    "meta": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/meta-server/index.js"],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_APP_ID": "${META_APP_ID}",
        "META_APP_SECRET": "${META_APP_SECRET}"
      }
    },
    "meta-official": {
      "type": "http",
      "url": "https://mcp.facebook.com/ads"
    },
    "meta-devtools": {
      "type": "http",
      "url": "https://mcp.facebook.com/devtools"
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "duckduckgo": {
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"]
    }
  }
}
