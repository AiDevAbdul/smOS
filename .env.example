# smOS env template — DO NOT FILL THIS FILE.
#
# Real secrets live at ~/.config/smos/.env (chmod 600), outside the repo.
# Loader precedence: $SMOS_ENV_FILE → ~/.config/smos/.env → repo .env (dev fallback).
# To bootstrap: `cp .env.example ~/.config/smos/.env && chmod 600 ~/.config/smos/.env`
# then fill the values in ~/.config/smos/.env.
#
# ─── Meta API ──────────────────────────────────────────────────────────────
# System user token — generate in Business Manager > System Users
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token

# ─── Supabase ──────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
SUPABASE_SERVICE_KEY=your_supabase_service_role_jwt
SUPABASE_PASSWORD=your_supabase_db_password

# ─── Discord ───────────────────────────────────────────────────────────────
# Create two webhooks in your Discord server: Server Settings > Integrations > Webhooks
# ALERTS   — ops/digest channel (daily optimizer summaries, report rollups)
# APPROVALS — approval channel (budget guards, campaign launches, strategy briefs)
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/your-alerts-webhook-here
DISCORD_WEBHOOK_APPROVALS=https://discord.com/api/webhooks/your-approvals-webhook-here

# ─── Google (Drive + Gmail) ────────────────────────────────────────────────
# OAuth credentials JSON from Google Cloud Console
GDRIVE_CREDENTIALS={"client_id":"...","client_secret":"..."}
GMAIL_CREDENTIALS={"client_id":"...","client_secret":"..."}
GMAIL_FROM_ADDRESS=reports@yourdomain.com

# ─── Notion (optional) ─────────────────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_token_here

# ─── Google Drive folder IDs ────────────────────────────────────────────────
# Root folder where per-client subfolders are created
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ─── Search (MCP servers) ──────────────────────────────────────────────────
# Tavily — primary web search for research tasks (1,000 free searches/month)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# DuckDuckGo — backup search, no key required (auto-enabled via plugin)

# ─── Krea (AI image generation, /image-gen) ────────────────────────────────
# Prepaid workspace balance — create a token at krea.ai/settings/api-tokens,
# top up at krea.ai/app/api/. Failed/cancelled jobs are not billed.
KREA_API_KEY=your_krea_api_token

# ─── Generated-asset hosting (/image-gen) ──────────────────────────────────
# /publish needs a public image_url — generated images are uploaded to this
# Supabase Storage bucket (must exist and be public) rather than relying on
# Krea's temporary output URL. Reuses SUPABASE_URL / SUPABASE_SERVICE_KEY above.
SMOS_ASSETS_BUCKET=smos-assets

# ─── Stripe (/billing) ─────────────────────────────────────────────────────
# Secret key for issuing invoices and creating recurring retainer subscriptions.
# Optional: without it /billing still generates local invoices (HTML+PDF) and
# records subscriptions as `invoice_manual` — it never claims a send it didn't
# make. Placeholder values (FILL_IN, changeme, your_..., <...>) count as UNSET,
# so a half-configured .env fails honestly instead of firing a doomed 401.
STRIPE_API_KEY=sk_test_your_stripe_secret_key
# Signing secret for the webhook reconciler (scripts/stripe-webhook.js). Required
# to apply webhook events — verification is fail-closed, since an unsigned
# "invoice.paid" is how someone would mark their own invoice settled.
# Get it from `stripe listen` or the endpoint's page in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── Signed share links (/agency-ops, tokenized client shares) ─────────────
# HMAC secret for signed, expiring share tokens (scripts/lib/share-token.js).
# Required only for `--share`. Replaces guessable public paths: a token names
# exactly which resource (and optionally which client) may be read, and expires.
# Values that are placeholders or under 16 chars count as UNSET — minting throws
# rather than producing an unsigned token.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SMOS_SHARE_SECRET=your_share_secret_here
